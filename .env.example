# EveryJob — environment template (Track 9: messaging + payments)
# Copy to .env for local dev. Never commit real values.
# Generate secrets with: openssl rand -base64 32

DATABASE_URL="postgresql://user:password@localhost:5432/everyjob"

# Public base URL of the deployment (share links, payment success URLs)
APP_BASE_URL="http://localhost:3000"

# Protects /api/cron/messaging (hourly automated-message trigger)
CRON_SECRET=""

# WhatsApp Cloud API webhook verification (Meta app dashboard webhook settings)
WHATSAPP_VERIFY_TOKEN=""

# Stripe platform keys — TEST mode first; live only after explicit owner confirmation
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_CLIENT_ID="ca_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 32-byte base64 key encrypting per-business WhatsApp tokens / Resend API keys at rest
# Generate: openssl rand -base64 32
MESSAGING_ENC_KEY=""

# ---- Ecosystem release (2026-09-25): all optional, all free-tier ----
# Web Push (PWA notifications) — generate free with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# QuickBooks Online sync — free Intuit developer app (user-owned); set QUICKBOOKS_SANDBOX=true for testing
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_SANDBOX="false"

# Optional: notify the product owner when a new support ticket arrives (best-effort, Resend free tier)
SUPPORT_OWNER_EMAIL=""
RESEND_API_KEY=""

# Product owner emails (comma-separated) — the only accounts that can see the
# support inbox and change ticket statuses. Leave empty to keep it closed.
OWNER_EMAILS=""
