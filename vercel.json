{
  "buildCommand": "prisma generate && prisma db push --skip-generate && next build",
  "crons": [
    {
      "path": "/api/cron/messaging",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/recurring",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/workflows",
      "schedule": "30 6 * * *"
    }
  ]
}