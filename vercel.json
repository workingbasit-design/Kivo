{
  "buildCommand": "prisma generate && sh scripts/apply-migrations.sh && prisma db push --skip-generate && next build",
  "crons": [
    {
      "path": "/api/cron/messaging",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recurring",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/workflows",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/agent-purge",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/error-alerts",
      "schedule": "0 7 * * *"
    }
  ]
}
