generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String?
  googleId      String?     @unique // Google OIDC `sub` for "Continue with Google" linking
  phone         String? // Canadian contact number (NANP), user-editable
  phonePrompted Boolean     @default(false) // onboarding contact-number prompt shown/skipped
  // M9: role + business assignment moved to Membership (the authority).
  // A user's current business context resolves via their ACTIVE membership
  // in requireAuth() (src/lib/auth.ts).
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  activeMembershipId String? // Part 0: explicit business-context override (Settings demo switch); null = earliest ACTIVE membership
  assignedJobs  Job[]       @relation("JobAssignedTo")
  jobNotes      JobNote[]   @relation("JobNoteAuthor")
  jobPhotos     JobPhoto[]  @relation("JobPhotoUploadedBy")
  timeEntries   TimeEntry[]
  jobAssignments JobAssignment[] // M19 (F4): multi-technician assignments
  crewMemberships CrewMember[]
  memberships   Membership[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // B7.4 TOTP 2FA: totpSecret is the base32 secret ENCRYPTED at rest
  // (src/lib/crypto.ts); totpBackupCodes is a JSON array of SHA-256 hashes
  // of single-use backup codes. Opt-in, except owners must enable before
  // connecting payments (enforced in the Stripe Connect route).
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String?
}

// Per-business team membership (Prompt 3, M1). This is the authority for
// permission checks — `User.role` / `User.businessId` are legacy single-
// business fields kept until M9, when they are dropped. A user can belong
// to several businesses with a different role in each.
model Membership {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        String // OWNER | ADMIN | DISPATCHER | TECHNICIAN (CHECK in migration)
  status      String // ACTIVE | INVITED | SUSPENDED | REMOVED (CHECK in migration)
  invitedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([businessId, status])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Single-use password-reset tokens. Only the SHA-256 hash of the raw token
// is stored — the raw token is emailed once and never persisted.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Business {
  id                   String                @id @default(cuid())
  name                 String
  regionCode           String                @default("CA")
  currency             String                @default("CAD")
  taxRegion            String?
  phone                String?
  whatsappNumber       String? // Preferred number for WhatsApp wa.me links; falls back to phone
  workingHours         String? // JSON string: {"mon":["09:00","18:00"],"tue":[...],...}; null = not configured
  address              String?
  taxId                String?               @map("gstin") // Canadian GST/HST number (CRA business number); DB column kept as gstin
  gstHstRegistered     Boolean               @default(false) // registered to collect GST/HST — invoices show tax lines only when true (M3)
  qstNumber            String? // Revenu Québec QST number (QC businesses)
  filingFrequency      String? // CHECK: MONTHLY|QUARTERLY|ANNUAL (M3 migration)
  upiId                String?
  interacEmail         String? // Interac e-Transfer email for CA businesses; shown on invoices (record-only, EveryJob never processes payments)
  timezone             String                @default("America/Toronto") // IANA timezone; NOT NULL since M9 (Canada-only app)
  defaultHourlyRateCents BigInt? // cents (M8 cutover); null = not set
  logoUrl              String?
  tagline              String? // brand kit tagline shown on quotes / social templates
  brandColors          String? // JSON: { primary: "#rrggbb", accent: "#rrggbb" }; null = defaults
  brandServices        String? // JSON array of service names for social templates; null = none set
  featureFlags         String? // JSON: { "portalV2": true }; per-business feature flags (F1+)
  portalTokens         CustomerPortalToken[]
  memberships          Membership[]
  customerLinks        CustomerLink[]
  documentCounters     DocumentCounter[]
  auditEvents          AuditEvent[]
  idempotencyKeys      IdempotencyKey[]
  webhookEvents        WebhookEvent[]
  confidentialityIncidents ConfidentialityIncident[]
  customers            Customer[]
  jobs                 Job[]
  services             Service[]
  invoices             Invoice[]
  creditNotes          CreditNote[]
  shareTokens          ShareToken[]
  quoteSignatures      QuoteSignature[] // F1
  portalEvents         PortalEvent[]    // F1
  messageLogs          MessageLog[]
  emailVerificationTokens EmailVerificationToken[]
  communications       Communication[]
  leads                Lead[]
  savedByCustomers   SavedPro[]
  customerQuotes     QuoteRequest[]
  agentProposals     AgentProposal[]
  quotes               Quote[]
  signatureRequests    SignatureRequest[]
  reviews              Review[]
  reviewRequests       ReviewRequest[]
  recurringJobs        RecurringJob[]
  timeEntries          TimeEntry[]
  jobAssignments       JobAssignment[] // M19 (F4): visits assigned to this user
  visitSignatures      VisitSignature[] // M19 (F4): business visit signatures
  bookingPage          BookingPage?
  bookableServices     BookableService[] // F7: services bookable online
  bookingRequests      BookingRequest[] // F7: customer booking submissions
  checklistTemplates   ChecklistTemplate[]
  expenses             JobExpense[]
  isDemo               Boolean               @default(false) // Part 0: seeded demo business — UI labels it "Demo" everywhere; never set for real businesses
  trade                String? // primary trade: plumbing|electrical|hvac|carpentry|painting|landscaping|cleaning|renovation|other
  teamSize             String? // E7 first-run answer: '1' | '2-5' | '6+'
  onboardingDone       Boolean               @default(false) // E7: true once the 3-question first run is completed or skipped
  yearsInBusiness      Int? // self-declared years operating; null = not set
  specialties          String? // JSON array of specialty strings; null = not set
  designations         Designation[]
  directoryOptIn       Boolean               @default(true) // show business in the public EveryJob directory
  directoryHideAddress Boolean               @default(true) // show area/city only, not the exact address
  directoryVerifiedAt  DateTime? // set when a directory claim is approved (or self-verified by the account holder). Public directory requires this + directoryOptIn.
  directoryClaim       DirectoryClaim?
  googleConnection     GoogleConnection?
  notificationSettings String? // JSON: { job_tomorrow: bool, job_soon: bool, ... }; null = all types on
  notifications        Notification[]
  messagingSettings    MessagingSettings?
  attachments          Attachment[]
  messagingConnections MessagingConnection[]
  messageQuotas        MessageQuota[]
  consentLogs          ConsentLog[]
  stripeConnection     StripeConnection?
  stripeEvents         StripeEvent[]
  quoteDeposits        QuoteDeposit[]
  directoryReports     DirectoryReport[]
  campaigns            Campaign[]
  automationLogs       AutomationLog[]
  templateOverrides    MessageTemplateOverride[]
  customerProperties   CustomerProperty[]
  customFieldDefs      CustomFieldDef[]
  payments             Payment[]
  piaAuditLogs         PiaAuditLog[]
  workflowRules        WorkflowRule[]
  pushSubscriptions    PushSubscription[]
  technicianLocations  TechnicianLocation[]
  trackingShares       TrackingShare[]
  quickBooksConnection QuickBooksConnection?
  quickBooksSyncLogs   QuickBooksSyncLog[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  supportTickets       SupportTicket[]
  equipment            Equipment[]
  parts                Part[]
  projects             Project[]
  crews                Crew[]
  savedReports         SavedReport[]
  digestSetting        DigestSetting?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Customer {
  id                   String                @id @default(cuid())
  name                 String
  phone                String?
  phoneNorm            String? // E.164 digits (no "+") for matching + WhatsApp links; `phone` keeps the user's formatting
  email                String?
  address              String?
  province             String? // Province/state code or name (e.g. "ON" for Ontario)
  postalCode           String? // Validated + formatted: "A1A 1A1" (CA) or 6-digit PIN (IN)
  notes                String?
  tags                 String? // comma-separated customer tags, e.g. "vip,senior,dog-friendly"
  messageConsent       Boolean               @default(false) // CASL express consent for automated messages; required before any auto-send
  messageConsentAt     DateTime? // when consent was given/withdrawn
  messageConsentSource String? // "settings-ui" | "whatsapp-inbound" | "customer-import"
  preferredLocale      String? // "en" | "fr"; null = business default
  archivedAt           DateTime? // soft-delete: hidden from lists, restorable; only unlinked customers can be hard-deleted
  archivedBy           String? // M7: User.id that archived the customer
  consentLogs          ConsentLog[]
  messageLogs          MessageLog[]
  properties           CustomerProperty[]
  fieldValues          CustomerFieldValue[]
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobs                 Job[]
  bookingRequests      BookingRequest[] // F7: booking requests from this customer
  invoices             Invoice[]
  quotes               Quote[]
  reviews              Review[]
  reviewRequests       ReviewRequest[]
  recurringJobs        RecurringJob[]
  portalTokens         CustomerPortalToken[]
  equipment            Equipment[]
  projects             Project[]
  customerLinks        CustomerLink[]
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, archivedAt, name]) // M12: customer list filtering
}

model Service {
  id            String   @id @default(cuid())
  name          String
  nameFr        String? // F6: French name; falls back to name when absent
  priceCents    BigInt // cents (M8 cutover: Float column dropped)
  costCents     BigInt? // F6: owner's cost in cents; drives margin display
  durationMin   Int? // typical job duration in minutes; pre-fills scheduling estimates
  description   String? // short plain-language description shown on quotes/booking
  descriptionFr String? // F6: French description
  kind          String   @default("SERVICE") // F6: SERVICE | PRODUCT (CHECK in M15)
  unit          String   @default("each") // F6: each | hour | job | sqft
  taxCategory   String   @default("TAXABLE_GST_HST") // F6: feeds F2 PDFs + C3 tax engine
  category      String? // F6: owner-defined grouping, e.g. Plumbing
  active        Boolean  @default(true) // F6: archived items are hidden, never hard-deleted by UI
  businessId    String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobs        Job[]
  bookableServices BookableService[] // F7: booking-page listings of this service
  bookingRequests  BookingRequest[] // F7: requests for this service
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, active])
}

model Job {
  id             String             @id @default(cuid())
  title          String
  date           DateTime
  time           String?
  startAt        DateTime? // canonical start (timestamptz); migrated from date+time; null = unscheduled
  endAt          DateTime? // optional end
  timeTbd        Boolean            @default(false) // time to be determined
  invoicedAt     DateTime? // set when the first non-voided invoice links to this job
  noCharge       Boolean            @default(false) // explicit $0 opt-in (warranty, goodwill)
  address        String?
  priceCents BigInt // cents (M8 cutover: Float column dropped)
  status         String // NEW, SCHEDULED, IN PROGRESS, COMPLETED, PAID, CANCELLED
  skippedAt      DateTime? // F3: when a recurring visit was skipped (stays visible, not deleted)
  notes          String?
  technician     String?
  assignedToId   String?
  assignedTo     User?              @relation("JobAssignedTo", fields: [assignedToId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recurringJobId String?
  recurringJob   RecurringJob?      @relation(fields: [recurringJobId], references: [id], onDelete: SetNull)
  serviceId      String? // optional link to the price-book service this job was created from
  service        Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]
  jobAssignments JobAssignment[] // M19 (F4): technicians assigned to this job
  visitSignatures VisitSignature[] // M19 (F4): customer signatures
  jobNotes       JobNote[]
  jobPhotos      JobPhoto[]
  expenses       JobExpense[]
  checklistItems JobChecklistItem[]
  invoices       Invoice[]
  idempotencyKey String?            @unique // booking-confirm dedupe key (UUID); null for jobs not created via booking
  bookingRequests BookingRequest[] // F7: requests that created this job
  technicianLocations TechnicianLocation[]
  trackingShare       TrackingShare?
  reviewRequests      ReviewRequest[]
  reviews             Review[]
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhaseId String?
  projectPhase   ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  crewId         String?
  crew           Crew?         @relation(fields: [crewId], references: [id], onDelete: SetNull)
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Backstop for recurring auto-generation idempotency: one job per plan per day.
  // NULL recurringJobId values never conflict, so manual jobs are unaffected.
  archivedAt   DateTime? // M7: soft-delete timestamp
  archivedBy   String?   // M7: User.id that archived the job

  @@unique([recurringJobId, date])
  @@index([businessId, status, date])
  @@index([businessId, date])
  @@index([businessId, status, startAt]) // M12: schedule/status lists
  @@index([businessId, customerId, startAt]) // M12: customer job history
}

model Invoice {
  id             String            @id @default(cuid())
  number         String
  date           DateTime
  subtotalCents BigInt // cents (M8 cutover: Float column dropped)
  taxRate        Float             @default(0)
  taxType        String? // "GST", "HST", "PST", "CGST", "SGST", "IGST"
  taxAmountCents BigInt // cents (M8 cutover: Float column dropped)
  totalCents BigInt // cents (M8 cutover: Float column dropped)
  status         String // UNPAID, PARTIALLY PAID, PAID
  sentAt         DateTime? // set when the pro emails the invoice to the customer (not a payment state)
  notes          String?
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  jobId          String? // set for progress/milestone invoices linked to a job
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  milestoneLabel String? // e.g. "Deposit", "Milestone 2 — rough-in", "Final"
  payments       Payment[]
  lineItems      InvoiceLineItem[]
  taxLines       InvoiceTaxLine[] // immutable per-invoice tax snapshot (M3)
  shareTokens    ShareToken[]
  creditNotes    CreditNote[]
  stripeCheckoutSessionId String? // latest Checkout session for online payment
  stripePaymentIntentId   String? // completed payment intent (idempotency)
  paidAt         DateTime? // set when fully paid (any channel)
  voidedAt       DateTime? // set when voided; voided invoices keep number, excluded from reports
  voidReason     String? // required reason for voiding
  dueAt          DateTime? // net-30 due date; set on issue/send, null for drafts (M10)
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([businessId, number]) // M10: document numbers unique per business
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, status, dueAt]) // M12: money outstanding / overdue lists
}

// Structured line items for an invoice. Items were previously stored as
// structured text in `notes`; this table is the canonical source now.
// The original notes text is preserved on the invoice (data migration).
model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  description String
  qty         Float
  unitPriceCents BigInt // cents (M8 cutover: Float column dropped)
  taxRateBps  Int? // snapshot of the applicable tax rate (basis points) at creation (M3)
  taxType     String? // snapshot of the tax type(s), e.g. "HST", "GST+QST" (M3)
  position    Int // display order
  createdAt   DateTime @default(now())
}

// Canonical Canadian sales-tax rates, versioned by effective date (M3).
// Rows are IMMUTABLE: corrections = insert a new row with a new
// effectiveFrom and close the old row's effectiveTo. A database trigger
// (tax_rates_no_update) rejects UPDATEs. Sent documents never read this
// table — they render from InvoiceTaxLine snapshots.
model TaxRate {
  id            String    @id @default(cuid())
  jurisdiction  String // province/territory code: AB, BC, MB, NB, NL, NS, NT, NU, ON, PE, QC, SK, YT
  taxType       String // CHECK: GST|HST|PST|RST|QST
  rateBps       Int // thousandths of a percent: 5000 = 5%, 9975 = 9.975% (see M3 migration note)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = still in force
  createdAt     DateTime  @default(now())

  @@unique([jurisdiction, taxType, effectiveFrom])
  @@index([jurisdiction, effectiveFrom])
}

// Per-invoice tax snapshot (M3). Written once when the invoice is
// finalized/sent; sent documents render ONLY from these rows — changing
// TaxRate later never changes a sent document.
model InvoiceTaxLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  taxType     String // CHECK: GST|HST|PST|RST|QST
  rateBps     Int
  baseCents   BigInt
  amountCents BigInt
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// Per-(business, document type) number counter (M4). Number generation
// happens inside the same transaction as the document insert:
// SELECT ... FOR UPDATE on the counter row -> format -> insert document ->
// nextNumber + 1. The row lock serializes per (business, type): no
// duplicates under concurrency; gaps only from rolled-back transactions.
model DocumentCounter {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  docType    String // CHECK: QUOTE|INVOICE|CREDIT_NOTE
  nextNumber Int      @default(1)
  prefix     String // "INV-", "Q-", "CN-"
  padding    Int      @default(4) // zero-pad width; grows beyond 9999
  updatedAt  DateTime @updatedAt

  @@unique([businessId, docType])
  @@index([businessId])
}

// Revocable, expirable capability tokens for public quote/invoice portals.
// The public pages (/q/[token], /i/[token]) resolve through this table only —
// raw cuid ids never work as public URLs. A token is usable only when
// revokedAt is null and (expiresAt is null or in the future).
model ShareToken {
  id         String    @id @default(cuid())
  token      String    @unique
  type       String // "QUOTE" | "INVOICE"
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  revokedAt  DateTime?
  maxViews   Int?      // F1: optional view cap for portal links
  lastViewedAt DateTime? // F1: last portal view timestamp
  portalEvents PortalEvent[] // F1
  createdAt  DateTime  @default(now())
}

model CustomerPortalToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // SHA-256 of the magic-link token; the raw token is never stored
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// F1: e-signature audit for portal quote acceptance. IP is stored hashed
// (SHA-256 + daily salt), never raw.
model QuoteSignature {
  id                String   @id @default(cuid())
  quoteId           String
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  signerName        String
  signerIpHash      String
  userAgent         String?
  consentedAt       DateTime
  acceptedOptionIds String? // JSON array of selected optional item ids
  createdAt         DateTime @default(now())

  @@index([quoteId])
  @@index([businessId])
}

// F1: append-only audit log for portal interactions.
model PortalEvent {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shareTokenId String?
  shareToken   ShareToken? @relation(fields: [shareTokenId], references: [id], onDelete: SetNull)
  kind         String // VIEW|ACCEPT|DECLINE|CHANGE_REQUEST|PAYMENT|PDF
  customerId   String?
  meta         String? // JSON
  createdAt    DateTime   @default(now())

  @@index([businessId])
  @@index([shareTokenId])
}

model Payment {
  id                      String   @id @default(cuid())
  amountCents BigInt // cents (M8 cutover: Float column dropped)
  provider                String // "STRIPE", "INTERAC", "CASH", "CHEQUE"
  transactionId           String?
  status                  String // "PENDING", "COMPLETED", "FAILED"
  stripePaymentIntentId   String?  @unique // pi_...; set for Stripe card payments
  stripeCheckoutSessionId String?  @unique // cs_...; set for Stripe Checkout payments
  receiptUrl              String? // Stripe receipt URL, when available
  invoiceId               String
  invoice                 Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  businessId              String // tenant scope; NOT NULL since M9
  business                Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  voidedAt                DateTime? // set when voided; payments are never deleted
  voidReason              String? // required reason for voiding
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, invoiceId, createdAt]) // M12: invoice payment history
  @@index([businessId, status]) // M12: revenue reports
}

// Credit note for post-send invoice corrections. Linked to the original invoice.
model CreditNote {
  id         String   @id @default(cuid())
  number     String // CN-0001 style, via DocumentCounter (M4)
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  amountCents BigInt // credit amount in cents
  reason     String // required reason for the credit
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime @default(now())

  @@unique([businessId, number]) // M10: document numbers unique per business
  @@index([businessId])
  @@index([invoiceId])
}

model MessageLog {
  id                String    @id @default(cuid())
  type              String // "SMS", "WHATSAPP", "EMAIL"
  recipient         String
  content           String
  status            String // "SENT", "FAILED", "DELIVERED", "BLOCKED_QUOTA", "BLOCKED_NO_CONSENT", "BLOCKED_QUIET_HOURS", "DRY_RUN", "DEFERRED"
  direction         String    @default("OUT") // "OUT" (we sent) | "IN" (customer replied, e.g. STOP/HELP)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  template          String? // MessageTemplateId, e.g. "reminder_24h"; null for manual/ad-hoc
  locale            String? // "en" | "fr"
  eventKey          String? // idempotency key for automated sends; null for manual
  error             String? // failure reason, when status is FAILED/BLOCKED_*
  providerMessageId String? // WhatsApp wamid / Resend id
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime  @default(now())

  @@index([businessId, eventKey])
  @@index([businessId, createdAt])
}

model Communication {
  id           String   @id @default(cuid())
  type         String // "CALL", "WHATSAPP", "SMS"
  contactName  String
  contactPhone String
  status       String // "WAITING", "REPLIED", "RESOLVED"
  waitingSince DateTime @default(now())
  content      String? // Message body or call summary
  jobCategory  String? // e.g. "AC repair"
  estValueCents BigInt? // cents (M8 cutover); null = not set
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobNote {
  id        String   @id @default(cuid())
  content   String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("JobNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([authorId]) // M10: FK index
}

model JobPhoto {
  id           String   @id @default(cuid())
  url          String
  caption      String?
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("JobPhotoUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById]) // M10: FK index
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  phoneNorm  String? // E.164 digits (no "+") for matching + WhatsApp links; `phone` keeps the user's formatting
  email      String?
  details    String?
  status     String // "NEW", "CONTACTED", "CONVERTED", "EXPIRED"
  source     String? // e.g., "WhatsApp", "Phone", "Website"
  declineReason String? // E5: reason captured when a lead is declined
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt  DateTime? // directory quote-request leads expire after 30 days if not contacted
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, status])
  @@index([expiresAt])
}

model Quote {
  id                String             @id @default(cuid())
  number            String
  title             String
  totalCents BigInt // cents (M8 cutover: Float column dropped)
  status            String // "DRAFT", "SENT", "APPROVED", "DECLINED"
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shareTokens       ShareToken[]
  signatures        QuoteSignature[] // F1
  signatureRequests SignatureRequest[]
  addons            QuoteAddon[]
  lineItems         QuoteLineItem[]
  depositAmountCents BigInt? // cents (M8 cutover); null = not set
  discountType      String? // "PERCENT" | "AMOUNT"; null = no discount
  discountValue     Float? // percent (0-100) when discountType=PERCENT — not money, never in cents (M8 keeps this column)
  discountValueCents BigInt? // cents (M8 cutover); null = not set (always null for PERCENT)
  deposits          QuoteDeposit[]
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  changeRequest      String?   // F1: customer's requested changes via portal
  changeRequestedAt  DateTime? // F1: when the change request was submitted
  createdAt            DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt]) // M12: quote list by status
  @@unique([businessId, number]) // M10: document numbers unique per business
}

model SignatureRequest {
  id            String    @id @default(cuid())
  tokenHash     String    @unique // SHA-256 of the signing-link token; raw token never stored
  status        String // "sent" | "viewed" | "signed" | "declined" | "expired" | "revoked"
  fieldsJson    String // JSON array of placed fields: {type: "signature"|"date"|"initials", x: number, y: number, page: number}
  signerName    String?
  signerContact String? // phone or email the link was shared to
  docHash       String // SHA-256 of canonical quote JSON at send time (tamper evidence)
  signatureData String? // data URL of drawn signature image, or typed name
  auditJson     String // JSON array of {event, at, ip}
  expiresAt     DateTime?
  revokedAt     DateTime?
  signedAt      DateTime?
  quoteId       String
  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id           String    @id @default(cuid())
  rating       Int // 1-5
  comment      String?
  // Provenance vocabulary (review moat, 2026-09): "Verified" = left by a
  // customer tied to a real completed job with a paid invoice (via a
  // single-use review-request token, or recorded by the owner against such
  // a job). "Google" = synced from Google Business Profile. "Legacy" =
  // recorded before the moat existed — kept for history, never verified.
  source       String? // "Verified" | "Google" | "Legacy"
  externalId   String? // Google review resource name (accounts/.../reviews/...) — dedupe key for sync; null for manual reviews
  reviewerName String? // Google reviewer display name; null when anonymous
  reviewedAt   DateTime? // Google's createTime; manual reviews use createdAt
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobId        String? // set for Verified reviews: the completed, paid job this review is about
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewRequest ReviewRequest?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([businessId, externalId]) // Postgres treats NULLs as distinct: many manual (null) rows allowed
  @@index([businessId, source])
}

// Review-request tokens (the review moat).
//
// A pro generates a link for ONE completed job that has a paid invoice.
// The customer opens /rev/[token] and can leave exactly one review, tied
// to that job + customer + business. Tokens are 256-bit random hex,
// stored only as SHA-256 hashes — a database leak reveals no usable links.
// Single-use, 30-day expiry, revocable by the pro.
model ReviewRequest {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  status      String    @default("PENDING") // PENDING, USED, REVOKED
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  reviewId    String?   @unique
  review      Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([jobId])
}

model RecurringJob {
  id         String   @id @default(cuid())
  title      String
  frequency  String // WEEKLY, BIWEEKLY, MONTHLY
  nextRun    DateTime
  time       String?
  address    String?
  priceCents BigInt? // cents (M8 cutover); null = not set
  notes      String?
  active     Boolean  @default(true)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobs       Job[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TimeEntry {
  id         String    @id @default(cuid())
  clockIn    DateTime
  clockOut   DateTime?
  notes      String?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  approvedAt DateTime? // M19 (F4): owner/admin approval of the timesheet entry
  approvedById String? // M19 (F4): User.id of the approving owner/admin
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// M19 (F4): multi-technician job assignments. Replaces the single
// Job.assignedToId for dispatch; that column stays for compatibility.
model JobAssignment {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedById String? // User.id of the dispatcher/owner who assigned

  @@unique([jobId, userId])
  @@index([businessId])
  @@index([userId, businessId])
  @@index([jobId])
}

// M19 (F4): customer signature captured on visit completion.
// The drawn signature image is stored in Blob; imageUrl is its URL.
model VisitSignature {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  signerName String
  imageUrl   String?
  signedAt   DateTime @default(now())
  createdBy  String // User.id of the technician who captured it

  @@index([jobId])
  @@index([businessId])
}

model BookingPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  enabled       Boolean  @default(true)
  headline      String?
  headlineFr    String? // Canadian French headline; falls back to headline
  intro         String?
  introFr       String? // Canadian French intro; falls back to intro
  description   String? // longer public "about" text (EN)
  descriptionFr String? // longer public "about" text (FR); falls back to description
  serviceAreas  String? // JSON array of city/area strings the business serves
  showPhone     Boolean  @default(true) // display phone/WhatsApp on the public profile
  // F7: online-booking settings
  approvalRequired Boolean @default(true) // true = requests need owner approval; false = instant booking
  bufferMin        Int     @default(30) // buffer minutes between visits
  depositRequired  Boolean @default(false) // require a deposit at booking time
  depositCents     BigInt? // deposit amount in cents (when depositRequired)
  embedEnabled     Boolean @default(true) // allow the /book/[slug]/embed widget
  businessId    String   @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookableServices BookableService[]
  bookingRequests  BookingRequest[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// F7: which price-book services are bookable online (per booking page).
model BookableService {
  id            String  @id @default(cuid())
  bookingPageId String
  bookingPage   BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  position      Int     @default(0) // display order on the booking page
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([bookingPageId, serviceId])
  @@index([businessId])
  @@index([bookingPageId, position])
}

// F7: a customer booking submission. NOT a Job until approved
// (approval-required mode). Instant mode creates the Job directly.
model BookingRequest {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingPageId String
  bookingPage   BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  phoneNorm     String?
  email         String?
  address       String?
  notes         String?
  slotStart     DateTime?
  slotEnd       DateTime?
  durationMin   Int?
  status        String   @default("PENDING") // PENDING, APPROVED, DECLINED, CANCELLED
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  depositCents  BigInt? // deposit charged for this request
  depositPaidAt DateTime? // set by the Stripe webhook when the deposit clears
  confirmToken  String   @unique // one-time token for the confirmation view; never in URLs with PII
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, status])
  @@index([bookingPageId])
}

model Campaign {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String
  audience   String // ALL_CUSTOMERS, WITH_UNPAID, RECENT_JOBS
  status     String // DRAFT, QUEUED, SENT
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DirectoryReport {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reason          String // e.g. "spam", "fake", "wrong-info", "other"
  details         String?
  reporterContact String?
  status          String   @default("OPEN") // OPEN, REVIEWED, DISMISSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

// Unmatched directory demand: a public quote request that matched no
// providers. Saved as a visible lead draft (status OPEN) so the request is
// never silently dropped — admins see the demand queue, and the requester
// gets a clear "saved, we'll notify you" confirmation.
model DirectoryRequest {
  id          String   @id @default(cuid())
  serviceNeed String
  city        String
  area        String?
  name        String
  phone       String
  phoneNorm   String?
  details     String?
  status      String   @default("OPEN") // OPEN, FULFILLED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([city])
}

// Directory claim / verification (Track 4A). A business with an EveryJob app
// account requests verification of its public directory listing; an admin
// (KIVO_ADMIN_EMAILS) explicitly approves or rejects. No auto-approval, no
// auto-sent messages. Unverified/unclaimed listings never go public.
model DirectoryClaim {
  id         String    @id @default(cuid())
  businessId String    @unique
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note       String? // business's note on request, or admin's note on decision
  decidedBy  String? // admin email that approved/rejected
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([status])
}

// Google Business Profile connection (Track 5). Stores OAuth tokens so the
// business can sync its Google reviews on demand with one tap. Tokens are
// DB-stored (trade-off: anyone with DB access can read them — Disconnect
// revokes at Google and deletes them). No background auto-sync: sync is an
// explicit user action only. Nothing is ever sent anywhere automatically.
model GoogleConnection {
  id              String    @id @default(cuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleAccountId String? // numeric account id from the Account Management API
  locationId      String? // numeric location id the business picked
  locationName    String? // display title of the picked location
  accessToken     String // short-lived OAuth access token (DB-stored)
  refreshToken    String? // long-lived refresh token (DB-stored)
  expiresAt       DateTime? // access token expiry
  scopes          String? // space-separated granted scopes
  connectedAt     DateTime  @default(now())
  lastSyncAt      DateTime?
  updatedAt       DateTime  @updatedAt
}

// ── Universal attachments (Track 6): files on jobs, customers, quotes,
// invoices, reviews and leads. Blob bytes live in Vercel Blob; this table is
// the tenant-scoped access control — raw blob URLs are never served
// cross-tenant (see /api/attachments/[id]).
model Attachment {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityType   String // job | customer | quote | invoice | review | lead
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  blobUrl      String
  blobPathname String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([businessId, entityType, entityId])
}

// ── Jobber-parity additions (all free) ──

model JobExpense {
  id          String   @id @default(cuid())
  jobId       String? // optional — null = general business expense (not tied to a job)
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amountCents BigInt // cents (M8 cutover: Float column dropped)
  category    String   @default("MATERIALS") // MATERIALS, TRAVEL, OTHER
  spentAt     DateTime @default(now())
  note        String? // optional longer note
  receiptUrl  String? // Vercel Blob URL of the receipt photo, when uploaded
  // F9: tax paid on the expense, in cents — feeds the sales-tax summary (C3).
  // Entered on the expense form (small-improvements); defaults to 0.
  taxGstHstCents BigInt @default(0)
  taxQstCents    BigInt @default(0)
  taxPstCents    BigInt @default(0)
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime @default(now())

  @@index([businessId, spentAt])
}

model QuoteAddon {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title     String
  priceCents BigInt // cents (M8 cutover: Float column dropped)
  selected  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([quoteId]) // M10: FK index
}

model ChecklistTemplate {
  id          String                  @id @default(cuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  priceCents BigInt? // cents (M8 cutover); null = not set
  durationMin Int? // optional default duration (minutes) when used as a job template
  notes       String? // optional default job notes when used as a job template
  items       ChecklistTemplateItem[]
  createdAt   DateTime                @default(now())
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int               @default(0)

  @@index([templateId]) // M10: FK index
}

model JobChecklistItem {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId]) // M10: FK index
}

// In-app notification center (Track 3). Notifications are GENERATED from real
// records (jobs, invoices, quotes, bookings, payments) — never seeded — and
// deduped by (businessId, dedupeKey) so a dismissed notification never
// reappears for the same underlying record. Read state is per business
// (1–5 person shops share one inbox). In-app only: nothing here ever sends
// WhatsApp/SMS/email.
model Notification {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // job_tomorrow | job_soon | invoice_overdue | quote_expiring | booking_new | payment_recorded
  data       String? // JSON display params (job title, customer name, amount...); titles render at read time in the viewer's locale
  href       String? // click-through, e.g. /jobs/<id>
  dedupeKey  String // stable per (business, type, source record)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  // M18 (F10): event-driven notifications link back to their source record
  // and can target a single business member. NULL = whole business.
  entityType String? // 'LEAD' | 'QUOTE' | 'INVOICE' | 'PAYMENT' | 'JOB' | 'BOOKING'
  entityId   String? // id of the source record (for "no longer available" states)
  userId     String? // when set, only this user sees the notification (technician-scoped)

  @@unique([businessId, dedupeKey])
  @@index([businessId, readAt, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// TRACK 9 — Automated messaging (free-quota only) + online payments (Stripe).
// User decision 2026-09-23: automated messaging and online payments are now
// OPT-IN features. Messaging only ever goes to customers with explicit
// opt-in consent (CASL), respects quiet hours, and HARD-STOPS at the free
// quota — the system cannot silently incur messaging charges. Payments flow
// through each business's OWN Stripe Connect account; EveryJob never holds
// money. Card data never touches our servers (Stripe Checkout only).
// ---------------------------------------------------------------------------

// Per-business automated-messaging toggles + guardrails. All automations
// default OFF; the owner opts in per trigger. dryRun defaults ON so the
// owner previews exactly what would send before anything goes out.
model MessagingSettings {
  id              String    @id @default(cuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reminder24h     Boolean   @default(false)
  reminderDayOf   Boolean   @default(false)
  invoiceDue      Boolean   @default(false)
  invoiceOverdue  Boolean   @default(false)
  quoteFollowup   Boolean   @default(false)
  reviewRequest   Boolean   @default(false)
  quietStartHour  Int       @default(21) // no automated messages 21:00–08:00 business tz
  quietEndHour    Int       @default(8)
  dryRun          Boolean   @default(true) // preview mode: log candidates, send nothing
  // Free-quota hard caps — verified 2026-09-23:
  // - whatsappLimit: Meta's 1,000 free service messages / calendar month / number
  // - emailLimit: Resend free tier 3,000 / month
  // - emailDailyLimit: Resend free tier 100 / day (binding constraint)
  whatsappLimit   Int       @default(1000)
  emailLimit      Int       @default(3000)
  emailDailyLimit Int       @default(100)
  quotaNotifiedAt DateTime? // last in-app quota-exhausted notice (avoid spam)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// F5: Per-business custom template overrides. When a business customizes a
// template, the override is used instead of the built-in version.
// Variables like {customerName} are still substituted at send time.
model MessageTemplateOverride {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  templateId String // MessageTemplateId, e.g. "reminder_24h"
  locale     String // "en" | "fr"
  subject    String
  body       String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([businessId, templateId, locale])
  @@index([businessId])
}

// A business's own messaging provider connections. Secrets (tokens/keys)
// are stored ENCRYPTED at rest (AES-256-GCM, see src/lib/messaging/crypto.ts),
// never logged, and only used for that business's sends.
model MessagingConnection {
  id               String    @id @default(cuid())
  channel          String // "WHATSAPP" | "EMAIL"
  provider         String // "META_WHATSAPP" | "RESEND"
  waPhoneNumberId  String? // WhatsApp Cloud API phone_number_id
  waBusinessAcctId String? // WhatsApp Business Account id
  waAccessToken    String? // Meta token (secret)
  waDisplayNumber  String? // the business's WhatsApp number, for display
  emailFromName    String?
  emailFromAddress String?
  emailApiKey      String? // Resend API key (secret)
  enabled          Boolean   @default(true)
  verifiedAt       DateTime?
  // B7.6: set when the business verifies its sending email via the 24h
  // verification link. The engine refuses customer emails until this is set.
  emailVerifiedAt  DateTime?
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([businessId, channel])
}

// Monthly per-business usage counters. The engine atomically reserves one
// unit per send and refuses to send past the free-quota limit (hard stop).
// B7.6: single-use business email verification tokens (128-bit, SHA-256
// hashed at rest, 24h expiry). The raw token is emailed once and never stored.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// B9.1: in-house error log (no Sentry - decision pending). Repeats are
// grouped by fingerprint; message/stack are PII-scrubbed before storage.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String
  kind        String // error | login_failure | webhook_failure | export_spike
  message     String
  stack       String?
  route       String?
  businessId  String?
  userId      String?
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @updatedAt

  @@index([fingerprint, lastSeen])
  @@index([kind, lastSeen])
}

// B9.2: alert dedup - one unresolved alert per key.
model MonitorAlert {
  id         String    @id @default(cuid())
  key        String
  businessId String?
  detail     String
  firedAt    DateTime  @default(now())
  resolvedAt DateTime?

  @@index([key, resolvedAt])
}

model MessageQuota {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month         String // "YYYY-MM" in the business's timezone
  whatsappCount Int      @default(0)
  emailCount    Int      @default(0)
  blockedCount  Int      @default(0) // sends refused because the quota was exhausted
  emailDay      String? // "YYYY-MM-DD" in the business's timezone (Resend free tier: daily cap)
  emailDayCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, month])
}

// CASL consent audit trail: every opt-in / opt-out / STOP / HELP, tenant-scoped.
model ConsentLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String // "WHATSAPP" | "EMAIL"
  action     String // "OPT_IN" | "OPT_OUT" | "STOP_RECEIVED" | "HELP_RECEIVED"
  source     String? // "settings-ui" | "whatsapp-inbound" | "customer-import"
  wording    String? // B14: consent text version shown (e.g. "v2026-10")
  createdAt  DateTime @default(now())

  @@index([businessId, customerId])
}

// The business's own Stripe account via Stripe Connect OAuth. Funds settle
// directly to the business; EveryJob never holds money.
model StripeConnection {
  id                 String    @id @default(cuid())
  businessId         String    @unique
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stripeAccountId    String    @unique // acct_...
  livemode           Boolean   @default(false)
  chargesEnabled     Boolean   @default(false)
  payoutsEnabled     Boolean   @default(false)
  onboardingComplete Boolean   @default(false)
  liveConfirmedAt    DateTime? // explicit owner confirmation before live charges
  bankFirstAboveCents BigInt? // C1: show "Pay by bank (lower fee)" first on invoices above this amount (cents); null = disabled
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Processed Stripe webhook events (idempotency: each event handled once).
model StripeEvent {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stripeEventId String    @unique // evt_...
  type          String // e.g. "checkout.session.completed"
  livemode      Boolean   @default(false)
  processedAt   DateTime? // set only after the handler succeeded; absent → Stripe retries
  createdAt     DateTime  @default(now())

  @@index([businessId])
}

// Deposit collection on a quote. Card deposits go through Stripe Checkout;
// manual deposits (Interac/cash/cheque) are recorded by the owner.
// EveryJob never holds money — Stripe settles to the business's account.
model QuoteDeposit {
  id                      String   @id @default(cuid())
  quoteId                 String
  quote                   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  businessId              String
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountCents BigInt // cents (M8 cutover: Float column dropped)
  provider                String   @default("STRIPE") // "STRIPE" | "INTERAC" | "CASH" | "CHEQUE"
  status                  String   @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED"
  stripePaymentIntentId   String?  @unique
  stripeCheckoutSessionId String?  @unique
  receiptUrl              String?
  note                    String?
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([quoteId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// TRACK 8 — safe automation + operational gaps.
// ---------------------------------------------------------------------------

// Durable log of automated runs (recurring generation, workflow engine,
// batch invoicing). The user can audit what the automation did and when.
model AutomationLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // "RECURRING" | "WORKFLOW" | "BATCH_INVOICE"
  summary    String
  metaJson   String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// A customer can have several service addresses (home, cottage, rental…).
model CustomerProperty {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String // "Home", "Cottage", …
  address    String
  notes      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([businessId])
}

// Business-defined custom fields for customers ("Gate code", "Dog name"…).
model CustomFieldDef {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  values     CustomerFieldValue[]
  createdAt  DateTime             @default(now())

  @@unique([businessId, name])
}

model CustomerFieldValue {
  id         String         @id @default(cuid())
  fieldId    String
  field      CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  value      String
  updatedAt  DateTime       @updatedAt

  @@unique([fieldId, customerId])
  @@index([customerId])
}

// Persisted quote line items (previously only the total was stored).
model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  qty         Float
  unitPriceCents BigInt // cents (M8 cutover: Float column dropped)
  taxRateBps  Int? // snapshot of the applicable tax rate (basis points) at creation (M3)
  taxType     String? // snapshot of the tax type(s), e.g. "HST", "GST+QST" (M3)
  position    Int // display order
  createdAt   DateTime @default(now())

  @@index([quoteId])
}

// Safe workflow engine: triggers are evaluated on a schedule; actions are
// LIMITED to in-app notifications and draft creation. There is deliberately
// no external-send path here — Track 9's consented messaging system remains
// the only way a message can leave the platform.
model WorkflowRule {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  trigger    String // "JOB_COMPLETED" | "QUOTE_AWAITING" | "INVOICE_OVERDUE"
  enabled    Boolean         @default(true)
  configJson String? // { followUpDays, graceDays, reviewDraft }
  events     WorkflowEvent[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([businessId])
}

// Idempotency markers: one row per (rule, entity) that already fired, so a
// re-run never notifies twice about the same job/quote/invoice.
model WorkflowEvent {
  id         String       @id @default(cuid())
  ruleId     String
  rule       WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType String // "JOB" | "QUOTE" | "INVOICE"
  entityId   String
  createdAt  DateTime     @default(now())

  @@unique([ruleId, entityType, entityId])
}

// Business credentials & designations (trade licences, Red Seal, provincial
// certifications, BBB, insurance/bonding, manufacturer certs). Self-declared
// by the business; never scraped or invented.
model Designation {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // LICENSE | RED_SEAL | PROVINCIAL_CERT | BBB | INSURANCE | BONDING | MANUFACTURER | OTHER
  title      String // e.g. "Red Seal Endorsement — Plumber"
  issuer     String? // issuing body, e.g. "Skilled Trades Ontario"
  number     String? // licence / certificate number
  issuedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId])
}

// ── Ecosystem release: PWA push, GPS tracking, QuickBooks, integrations
// platform, support. All tenant-scoped; $0 infra (VAPID web push, Leaflet/OSM,
// Stripe Connect already in use).

// Web Push subscriptions (PWA). One row per device per business.
model PushSubscription {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String? // team member who owns the device; null = unknown
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// GPS pings from a technician's device. Written ONLY while the tech has an
// active job and location sharing enabled (privacy-first: no background
// tracking outside jobs). Old pings are pruned by a daily cron.
model TechnicianLocation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String // team member sharing location
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([businessId, recordedAt])
  @@index([jobId])
}

// Customer-facing live-tracking link for a job ("tech is on the way").
// Resolved by unguessable token; expires automatically.
model TrackingShare {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// QuickBooks Online connection (OAuth2). Tokens are tenant-scoped.
model QuickBooksConnection {
  id           String    @id @default(cuid())
  businessId   String    @unique
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  realmId      String // QuickBooks company id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime  @default(now())
  lastSyncAt   DateTime?
  updatedAt    DateTime  @updatedAt
}

// Item-level QuickBooks sync results — every entity accounted for, nothing
// silently dropped.
model QuickBooksSyncLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityType String // customer | invoice | payment
  entityId   String // EveryJob id
  qbId       String? // QuickBooks id once synced
  status     String // synced | failed | skipped
  detail     String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// Tenant API keys for the public REST API (hashed at rest).
model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique // sha256 hex of the full key
  keyPrefix  String // first 8 chars, for identification in UI
  scopes     String    @default("read") // comma-separated: read, write
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// Outgoing webhooks (Zapier/Make-compatible).
model WebhookEndpoint {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  secret     String // HMAC-SHA256 signing secret
  events     String // JSON array of subscribed event names
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([businessId])
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  payload    String // JSON
  status     String          @default("pending") // pending | delivered | failed
  attempts   Int             @default(0)
  nextRetry  DateTime?
  lastError  String?
  createdAt  DateTime        @default(now())

  @@index([endpointId, createdAt])
}

// Support tickets from EveryJob users (routed to the app owner by email).
model SupportTicket {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name       String
  email      String
  subject    String
  message    String
  status     String    @default("open") // open | answered | closed
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
}

// Durable rate-limit buckets. Replaces the in-memory limiter so limits
// hold across Vercel serverless instances and cold starts. Key is
// "scope:identifier" (e.g. "auth:1.2.3.4"). Not tenant-scoped by design.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// PII access audit log. Records when authenticated users view/export
// customer PII (names, phones, emails, addresses). PIPEDA accountability.
// General audit log (M5) — every consequential action in the app writes
// one row here. APPEND-ONLY: a database trigger (audit_events_no_update_delete)
// rejects UPDATE/DELETE, and RLS policies allow only SELECT/INSERT.
// PiaAuditLog (above) stays as-is for PII view/export/search logging.
model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String // User.id, or 'system'
  actorType  String // CHECK: USER|SYSTEM|WEBHOOK|COPILOT
  action     String // CHECK: action vocabulary (see migration)
  entityType String // e.g. "Invoice", "Payment", "Customer"
  entityId   String?
  beforeJson String? // JSON snapshot before the change (secrets scrubbed)
  afterJson  String? // JSON snapshot after the change (secrets scrubbed)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

// Idempotency keys for payment + message-send endpoints (M6). First call
// with a key executes and stores the response; a replay with the same key
// returns the stored response WITHOUT re-executing. Keys expire after 24h.
// businessId is nullable for pre-auth endpoints (public quote requests) —
// null-business rows are scoped by (endpoint, key) via a partial unique
// index (see migration); they must be read/written through unsafeUnscoped
// because the tenant guard requires a non-empty businessId.
model IdempotencyKey {
  id           String    @id @default(cuid())
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key          String // client-supplied UUID from the Idempotency-Key header
  endpoint     String // e.g. "POST /api/v1/payments"
  responseJson String? // stored response for replays
  statusCode   Int?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime // createdAt + 24h

  @@unique([businessId, endpoint, key])
  @@index([expiresAt])
}

// Inbound webhook events from all providers (M6). StripeEvent rows were
// migrated here; StripeEvent is kept read-only (deprecated) — new events
// land in this table. Handler: insert (on conflict → skip as duplicate),
// process, set processedAt. businessId is nullable because webhooks may
// arrive before the business is resolved (same unsafeUnscoped note as
// IdempotencyKey).
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String // CHECK: STRIPE|QUICKBOOKS|RESEND|META
  providerEventId String
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type            String // e.g. "checkout.session.completed"
  payloadJson     String // raw provider payload
  processedAt     DateTime? // set only after the handler succeeded
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([businessId, createdAt])
}

// Quebec Law 25 confidentiality-incident register (M7). One row per
// incident: detect → contain → assess → notify → record → review (see
// docs/INCIDENT_RUNBOOK.md). businessId is nullable for platform-level
// incidents (same null-business handling as WebhookEvent).
model ConfidentialityIncident {
  id                 String    @id @default(cuid())
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  occurredAt         DateTime
  discoveredAt       DateTime
  summary            String
  dataTypes          String // JSON array of affected data types
  affectedCount      Int?
  notifiedCommission Boolean   @default(false) // CAQ notified (serious harm risk)
  notifiedAffected   Boolean   @default(false) // affected persons notified
  measuresTaken      String?
  status             String // CHECK: OPEN|CONTAINED|CLOSED
  createdBy          String? // User.id that recorded the incident
  createdAt          DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([status])
}

model PiaAuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  action     String // "view" | "export" | "search"
  entityType String // "customer" | "job" | "invoice" | etc.
  entityId   String?
  metadata   String? // JSON: e.g. {"count": 25} for exports
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}

// Equipment tracking — per-customer equipment records (HVAC units, appliances,
// etc.) so technicians know what they're servicing. Housecall Pro parity.
model Equipment {
  id          String    @id @default(cuid())
  name        String // e.g. "Furnace", "AC Unit", "Water Heater"
  brand       String?
  model       String?
  serial      String?
  installDate DateTime?
  notes       String?
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([customerId])
  archivedAt DateTime? // M7: soft-delete timestamp
  archivedBy String?   // M7: User.id that archived the equipment

}

// Parts inventory — track stock quantities for materials/parts.
// Lightweight: name, SKU, quantity on hand, reorder point, unit cost.
model Part {
  id           String   @id @default(cuid())
  name         String
  sku          String?
  quantity     Float    @default(0)
  reorderPoint Float? // alert when quantity <= reorderPoint
  unitCostCents BigInt? // cents (M8 cutover); null = not set
  unit         String? // e.g. "each", "ft", "box"
  notes        String?
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, name])
}

// ─── Customer (homeowner) accounts ──────────────────────────────────────
// Separate from business User accounts. Customers use the directory to find
// pros, save favorites, send quote requests, and message businesses.

model CustomerUser {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String?
  phone         String?
  city          String?
  locale        String      @default("en")
  agentCreatedAt DateTime? // set when the account was created by an AI-agent proposal approval (no usable password yet — claim via the confirmation link)
  sessions      CustomerSession[]
  savedPros     SavedPro[]
  quoteRequests QuoteRequest[]
  agentKeys     CustomerAgentKey[]
  customerLinks CustomerLink[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Explicit, optional link between a consumer account (CustomerUser) and a
// business's contact record (Customer) — Prompt 3, M2. Links are created
// ONLY by explicit user action (customer taps "This is me" on a portal
// page and confirms, or the owner links after the customer confirms).
// Never auto-matched by email/phone. No data is merged by linking — it
// only grants the consumer portal access to that business's records for
// that customer. Deleting either side removes the link (Cascade).
model CustomerLink {
  id             String       @id @default(cuid())
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      String? // user id (membership user or customer) that created the link
  createdAt      DateTime     @default(now())

  @@unique([customerUserId, customerId, businessId])
  @@index([customerUserId])
  @@index([customerId])
  @@index([businessId])
}

model CustomerSession {
  id         String       @id @default(cuid())
  customerId String
  expiresAt  DateTime
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model SavedPro {
  id         String       @id @default(cuid())
  customerId String
  businessId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([customerId, businessId])
  @@index([customerId])
}

model QuoteRequest {
  id          String         @id @default(cuid())
  customerId  String
  businessId  String
  service     String
  description String?
  status      String         @default("sent") // sent | replied | accepted | declined | completed
  source      String         @default("customer") // customer | agent — how the request originated
  messages    QuoteMessage[]
  customer    CustomerUser   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([businessId])
}

model QuoteMessage {
  id             String       @id @default(cuid())
  quoteRequestId String
  senderType     String       // "customer" | "business"
  body           String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
}

/// EveryJob Agent Protocol — a pending action proposed by a customer's
/// AI assistant on their behalf.
///
/// NOTHING reaches the business until the human approves via the
/// unguessable confirmation link (/a/[confirmToken]). The assistant only
/// ever proposes; the human disposes. Expired or declined proposals are
/// purged after 30 days; approved ones are kept for audit.
model AgentProposal {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique // client-supplied Idempotency-Key: retries never double-create
  agentName      String // "Muse", "Dot", or the agent's self-declared label
  agentKeyId     String? // CustomerAgentKey id when the proposal came from an authenticated customer key
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String? // set when the customer was resolved (agent key, or matched account)
  customerName   String
  customerPhone  String?
  customerEmail  String?
  customerCity   String?
  service        String
  description    String
  status         String    @default("pending") // pending | approved | declined | expired
  confirmToken   String    @unique // unguessable capability token for /a/[token]
  quoteRequestId String? // set on approval
  createdAt      DateTime  @default(now())
  expiresAt      DateTime // 24h after creation
  decidedAt      DateTime?

  @@index([businessId, status])
  @@index([status, expiresAt])
  @@index([customerId])
}

/// Customer-scoped agent keys: "Connect your AI assistant".
/// A logged-in customer generates a key, pastes it into their agent
/// (Muse, Dot, ...), and the agent can then search the directory and
/// propose quote requests AS that customer — identity comes from the key,
/// never from re-typed form fields. Keys can propose only; every proposal
/// still needs the human's one-tap confirmation.
///
/// Only the SHA-256 hash is stored; plaintext is shown once at creation.
model CustomerAgentKey {
  id         String       @id @default(cuid())
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  keyHash    String       @unique
  keyPrefix  String // first 8 chars, for identification in the UI
  label      String // "Muse", "My Dot", ...
  scopes     String       @default("read,write") // read = directory search; write = propose quote requests
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([customerId])
}

/// "Get it done for me" concierge — one row per customer tap of "Send
/// requests". The idempotencyKey is a client-generated UUID: double-taps,
/// retries, and replayed requests resolve to this row instead of creating
/// duplicate quote requests.
model ConciergeSend {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  customerId     String
  businessIds    String[] // business ids that received a quote request
  requestIds     String[] // exact quoteRequest ids created by this send (replay identity)
  service        String
  createdAt      DateTime @default(now())

  @@index([customerId])
}

/// Projects: container for larger, longer, multi-visit work. A project groups
/// jobs into phases (milestones), giving office + field one shared structure.
model Project {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      String         @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  budgetCents Int?
  startDate   DateTime?
  endDate     DateTime?
  phases      ProjectPhase[]
  jobs        Job[]
  createdBy            String? // M7: User.id of the acting membership user; 'system' for system/cron writes
  updatedBy            String? // M7: User.id of the last acting membership user
  createdAt            DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([businessId, status])
}

/// A phase (milestone) inside a project. Jobs attach to a phase; phases order
/// the work from kickoff to handoff.
model ProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int       @default(0)
  status    String    @default("TODO") // TODO, IN_PROGRESS, DONE
  dueDate   DateTime?
  jobs      Job[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, order])
}

/// Crews: named groups of technicians scheduled as a unit instead of one by one.
model Crew {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  members    CrewMember[]
  jobs       Job[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([businessId])
}

model CrewMember {
  id        String   @id @default(cuid())
  crewId    String
  crew      Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String // display name; falls back to linked user's name
  role      String?
  createdAt DateTime @default(now())

  @@index([crewId])
}

/// Saved reports from the natural-language report builder: the prompt plus the
/// resolved config, so a report can be re-run without re-asking.
model SavedReport {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  prompt     String
  configJson String // { type, dateRange, groupBy, ... }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

/// Morning briefing digest preferences: one row per business.
model DigestSetting {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(true)
  sendTime   String   @default("07:00") // local HH:mm
  channels   String   @default("IN_APP") // comma list: IN_APP, PUSH
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
